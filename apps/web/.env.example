# Copy to .env.local and fill in. .env.local is git-ignored.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Browser key: restrict by HTTP referrer, enable Maps JavaScript API + Places API.
# The SERVER key (Distance Matrix / Directions) belongs in Edge Function secrets only:
#   supabase secrets set GOOGLE_MAPS_SERVER_KEY=...
VITE_GOOGLE_MAPS_BROWSER_KEY=

# Web Push (passenger + driver notifications): the VAPID public key from
#   npx web-push generate-vapid-keys   (the private key is an Edge Function secret)
VITE_VAPID_PUBLIC_KEY=

# Demo mode only: lets `pnpm dev` read real tickets (FR-18 ticket import) without
# Supabase. No VITE_ prefix, so it stays on the dev server and never reaches the
# browser. With Supabase, the key is an Edge Function secret instead.
ANTHROPIC_API_KEY=
