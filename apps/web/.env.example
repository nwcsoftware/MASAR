# Copy to .env.local and fill in. .env.local is git-ignored.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Browser key: restrict by HTTP referrer, enable Maps JavaScript API + Places API.
# The SERVER key (Distance Matrix / Directions) belongs in Edge Function secrets only:
#   supabase secrets set GOOGLE_MAPS_SERVER_KEY=...
VITE_GOOGLE_MAPS_BROWSER_KEY=
