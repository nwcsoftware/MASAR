# Edge Function secrets. Local: copy to supabase/functions/.env (git-ignored) and run
#   pnpm supabase functions serve --env-file supabase/functions/.env
# Hosted: pnpm supabase secrets set ANTHROPIC_API_KEY=... GOOGLE_MAPS_SERVER_KEY=... SITE_URL=...
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are injected by Supabase.

# ai-suggest-airports — required (Claude normalises / suggests airports)
ANTHROPIC_API_KEY=
# ai-suggest-airports — optional: Places + Distance Matrix; without it Claude lists
# airports from knowledge and drive times are estimated. Server key, never ship to the browser.
GOOGLE_MAPS_SERVER_KEY=
# invite-user — where invite links land (/accept-invite)
SITE_URL=http://localhost:5173
